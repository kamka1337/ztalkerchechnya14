<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">

    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 TexturePath="/Textures/_Stalker/Logo/zagruzzka.png"
                 Stretch="KeepAspectCovered" />

    <!-- Main Container -->
    <LayoutContainer Name="MainContainer">
        <!-- Default State: Spans 100% of the screen so buttons are positioned in the exact center of the screen -->
        <BoxContainer Name="DefaultState" Orientation="Vertical" MouseFilter="Ignore">
            <!-- Spacers to center buttons vertically and horizontally, positioned below Chechnya 14 logo -->
            <Control VerticalExpand="True" SizeFlagsStretchRatio="1.3" MouseFilter="Ignore" />

            <BoxContainer Name="CenterButtons"
                          Orientation="Vertical"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <PanelContainer Name="ButtonCard" StyleClasses="LobbyButtonCard" MinWidth="440">
                    <BoxContainer Orientation="Vertical" SeparationOverride="18" Margin="24 24 24 24">
                        <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                Text="{Loc 'lobby-state-play-button'}"
                                StyleClasses="LobbyPlayButton"
                                MinWidth="380" MinHeight="62" />
                        <Button Name="OptionsButton" Access="Public"
                                Text="{Loc 'ui-lobby-options-button'}"
                                StyleClasses="LobbyMenuButton"
                                MinWidth="380" MinHeight="62" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <Control VerticalExpand="True" SizeFlagsStretchRatio="1.0" MouseFilter="Ignore" />

            <!-- Preserved hidden dummy controls needed by SS14 LobbyState & systems -->
            <BoxContainer Name="HiddenDummies" Visible="False">
                <BoxContainer Name="LeftSide" Visible="False">
                    <BoxContainer Name="TopLeft" Visible="False">
                        <PanelContainer Name="LeftSideTop" Visible="False">
                            <info:LinkBanner Name="LinkBanner" Visible="False" />
                            <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public" Visible="False"
                                                WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                            <Label Name="StartTime" Access="Public" Visible="False" />
                            <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public" />
                        </PanelContainer>
                        <BoxContainer Name="VoteContainer" Access="Public" Visible="False" />
                    </BoxContainer>
                    <info:DevInfoBanner Name="DevInfoBanner" Visible="False" />
                    <RichTextLabel Name="LobbySong" Access="Public" Visible="False" />
                    <RichTextLabel Name="LobbyBackground" Access="Public" Visible="False" />
                </BoxContainer>
                <Label Name="ServerName" Access="Public" Visible="False" />
                <Button Name="AHelpButton" Access="Public" Visible="False" />
                <vote:VoteCallMenuButton Name="CallVoteButton" Visible="False" />
                <Button Name="LeaveButton" Access="Public" Visible="False" />
                <info:ServerInfo Name="ServerInfo" Access="Public" Visible="False" />
                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" Visible="False" />
            </BoxContainer>
        </BoxContainer>

        <!-- Character Setup State -->
        <Control Access="Public" Visible="False" Name="CharacterSetupState" />

        <!-- Right Panel: Styled Chat Docked to the Right -->
        <PanelContainer Name="RightSide" Access="Public" StyleClasses="LobbyChatPanel">
            <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="10 10 10 10" SeparationOverride="8">
                <!-- Top row: Header with Radio broadcast title and time -->
                <BoxContainer Orientation="Horizontal" Name="HeaderContainer" Access="Public" SeparationOverride="6" MinHeight="36">
                    <Label Text="РАДИОЭФИР" StyleClasses="LabelHeadingBigger" FontColorOverride="#E0E6EE" VAlign="Center" HorizontalExpand="True" />
                    <Label Name="StationTime" Access="Public" FontColorOverride="#8A92A0" VAlign="Center" Margin="0 0 8 0" />
                    <TextureButton Name="CollapseButton"
                                   TexturePath="filled_right_arrow.svg.192dpi"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   ModulateSelfOverride="#B0B6C0"
                                   Scale="0.5 0.5" />
                </BoxContainer>
                <!-- Divider line -->
                <controls:HLine StyleClasses="highlight" Thickness="1" />

                <!-- Main Chat Box -->
                <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" HorizontalExpand="True" MinHeight="100" />
            </BoxContainer>
        </PanelContainer>

        <!-- Collapsed Chat Expand Button -->
        <PanelContainer Name="ExpandPanel"
                        StyleClasses="BackgroundPanel"
                        Visible="False">
            <TextureButton Name="ExpandButton"
                           TexturePath="filled_left_arrow.svg.192dpi"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ModulateSelfOverride="#DEDEDE"
                           Scale="0.5 0.5" />
        </PanelContainer>
    </LayoutContainer>
</lobbyUi:LobbyGui>
